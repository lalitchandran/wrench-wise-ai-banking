# Apex OmniBank Multi-Agent System Environment Variables

# Optional: Add your OpenAI API key to enable GPT-4o / GPT-4o-mini reasoning.
# If omitted or left as default, the system automatically uses its high-fidelity
# deterministic banking heuristics and offline NLP pipeline.
OPENAI_API_KEY=your_openai_api_key_here

# Core Engine Settings
DATABASE_PATH=banking.db
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
